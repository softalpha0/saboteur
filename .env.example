# Claude (live mode only; not needed for `saboteur run --replay`)
ANTHROPIC_API_KEY=
# Set to a Claude model id you have access to. The code never hard-codes one.
ANTHROPIC_MODEL=

# Kane CLI basic auth (CI / non-interactive only). Locally, use `kane-cli login` instead.
# TestMu dashboard -> Settings -> Keys
LT_USERNAME=
LT_ACCESS_KEY=

# Optional Kane CLI Chrome tuning (documented defaults: 30000 ms, 2 retries)
# KANE_CLI_CDP_TIMEOUT_MS=30000
# KANE_CLI_CDP_RETRIES=2
# KANE_CLI_CHROME_PATH=
