    { "id": "todomvc-after", "text": "React TodoMVC, with Claude's Kane-proven tests", "kind": "score", "file": "todomvc-run", "side": "after", "expect": "10/10" },
    { "id": "todomvc-rules", "text": "React TodoMVC, spec rules that would break silently", "kind": "rules", "file": "todomvc-run", "requirements": "apps/todomvc/mutations/requirements.json", "expect": "7 of 7 -> 0 of 7" }
  ]
